<%- include('partials/head') %>

<section class="container py-5">
  <div class="text-center mx-auto mb-5 py-4">
    <p class="fs-4 fw-semibold lh-lg mb-0">
      ॐ ऐं सरस्वत्यै नमः॥
    </p>
    <p class="text-body-secondary lh-lg mt-2 mb-0">
      मैं ज्ञान, विद्या और बुद्धि की देवी माँ सरस्वती को नमन करता हूँ।
    </p>
    <hr class="w-25 mx-auto my-4">
  </div>
  <% if (categories.length) { %>
    <nav class="d-flex flex-wrap justify-content-center gap-2" aria-label="Categories">
      <% categories.forEach((category) => { %>
        <a class="btn btn-outline-secondary btn-sm rounded-pill" href="#<%= category.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>"><%= category %></a>
      <% }) %>
    </nav>
  <% } %>
</section>

<section class="container pb-5">
  <% if (!posts.length) { %>
    <div class="alert alert-secondary">No posts yet. Add a Markdown file to <code>posts/</code>.</div>
  <% } %>

  <% categories.forEach((category) => { %>
    <% const categoryPosts = posts.filter((post) => post.category === category); %>
    <section class="mb-5" id="<%= category.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>">
      <div class="d-flex align-items-baseline justify-content-between gap-3 mb-3">
        <h2 class="h4 mb-0"><%= category %></h2>
        <span class="small text-body-secondary"><%= categoryPosts.length %> <%= categoryPosts.length === 1 ? 'post' : 'posts' %></span>
      </div>

      <div class="list-group shadow-sm">
        <% categoryPosts.forEach((post) => { %>
          <a class="list-group-item list-group-item-action p-4" href="/posts/<%= post.slug %>">
            <div>
              <h3 class="h5 mb-1"><%= post.title %></h3>
              <% if (post.description) { %><p class="text-body-secondary mb-0"><%= post.description %></p><% } %>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3 small text-body-secondary">
              <% if (post.dateText) { %><time class="me-1"><%= post.dateText %></time><% } %>
              <% post.tags.forEach((tag) => { %><span class="badge text-bg-secondary rounded-pill"><%= tag %></span><% }) %>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
  <% }) %>
</section>

<%- include('partials/footer') %>
